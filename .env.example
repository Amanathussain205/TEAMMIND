# Copy this file to .env and fill in the values. Never commit .env.

# LLM provider
OPENAI_API_KEY=
LLM_MODEL=
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=teammind

# Auth (use a long random string)
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Shared password for the Phase 1 demo users (bilal, hira, ayesha, kamran, zara, noor)
DEMO_PASSWORD=teammind-demo

# Storage (git-ignored)
CHROMA_DIR=storage/chroma
SQLITE_PATH=storage/teammind.db
